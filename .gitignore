# 默认忽略全部文件，只保留 README 和核心源码
*

# 基础保留文件
!/.gitignore
!/README.md
!/.python-version
!/go.mod
!/requirements.txt
!/vercel.json

# 核心目录
!/api/
!/api/**
!/backend/
!/backend/**
!/frontend/
!/frontend/**
!/ai_service/
!/ai_service/**
!/tasks/
!/tasks/**

# 本地临时/分析文件
/.omx/
/repo-context.md
/MEMORY.md

# OS / IDE
.DS_Store
Thumbs.db
.idea/
.vscode/

# Frontend
frontend/node_modules/
frontend/.vite/
frontend/dist/
frontend/npm-debug.log*
frontend/build.log
frontend/build_err.txt
frontend/.env

# Backend
backend/.gocache/
backend/.gomodcache/
backend/run.log
backend/run.err
backend/xianqu.db
backend/database.db
backend/*.exe
backend/dist/
backend/uploads/
backend/.env

# Runtime uploads
uploads/

# Logs
*.log

# AI service
ai_service/.venv/
ai_service/.env
ai_service/__pycache__/
ai_service/ai_service.log
**/__pycache__/
*.py[cod]

# Cloud / deploy caches
.wrangler/
**/.wrangler/
.vercel

# Misc local
.env
.gstack/

.dev.vars*
!.dev.vars.example
!.env.example
